{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "dnsquery",
    "namespace": "platform-optional",
    "labels": {
      "app.kubernetes.io/name": "dnsquery",
      "app.kubernetes.io/part-of": "homelab-platform"
    }
  },
  "spec": {
    "type": "ClusterIP",
    "selector": {
      "app.kubernetes.io/name": "dnsquery"
    },
    "ports": [
      {
        "name": "http",
        "port": 8080,
        "targetPort": "http",
        "protocol": "TCP"
      }
    ]
  }
}
